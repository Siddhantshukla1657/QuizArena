{
  "name": "quizarena",
  "version": "1.0.0",
  "description": "Live, host-run quiz app — Kahoot-style, runs entirely local/LAN",
  "scripts": {
    "start": "node server/index.js",
    "build": "vite build client",
    "dev:server": "node server/index.js",
    "dev:client": "vite client --host 0.0.0.0 --port 5173",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "loadtest": "node loadtest/simulate.js",
    "test": "node server/test-import.js && node server/test-answer-reveal.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.5",
    "sql.js": "^1.12.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.1",
    "socket.io-client": "^4.7.5",
    "vite": "^5.3.4"
  }
}
